# Use Node.js 24+. Run npm run setup to generate local secrets.
PORT=5000
HOST=127.0.0.1

# Local MongoDB, or your Atlas URI. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/simplechat

# Signs short-lived sessions. npm run setup replaces this placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# 32 random bytes in hex. Protect and back up this key; keep it stable.
# Used only for email encryption and lookup, NEVER for message encryption.
DATA_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Required with NODE_ENV=production; exact HTTPS origin, no trailing slash.
# PUBLIC_ORIGIN=https://chat.example.com
# NODE_ENV=production

# Set to 1 ONLY when behind exactly one trusted reverse proxy.
# TRUST_PROXY=1
